# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Unsplash (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Gmail SMTP (use a Gmail app password, NOT your main password)
GMAIL_USERNAME=99anujbansal@gmail.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Unsplash (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Gmail SMTP (use a Gmail app password, NOT your main password)
GMAIL_USERNAME=99anujbansal@gmail.com
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENT=99anujbansal@gmail.com

# Profile file path (local dev). In GH Actions, profile is decoded from secret.
PROFILE_PATH=./master_profile.json

# DB
DB_PATH=./db/state.sqlite

# Logging
LOG_LEVEL=INFO

# Buffer (https://publish.buffer.com/developers/apps)
BUFFER_ACCESS_TOKEN=
BUFFER_LINKEDIN_PROFILE_ID=

# Approval flow
HMAC_SECRET=
APPROVAL_BASE_URL=https://approval.<your-name>.workers.dev

# Post scheduling
POST_LOCAL_TIMEZONE=America/New_York
POST_LOCAL_TIME=11:00

# Phase 4 — broader content + Gemini imagery (both optional).
# GEMINI_API_KEY enables AI-generated images for trending / concept /
# news_take / tutorial posts via Google's Imagen API.
# Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional override for the RSS feeds used by the trending + news_take
# post types. Comma-separated "Name|URL" pairs. Leave blank to use the
# bundled defaults (Anthropic, Google AI, OpenAI, MIT Tech Review, etc).
# Example: "Anthropic|https://www.anthropic.com/news/rss.xml,HF|https://huggingface.co/blog/feed.xml"
RSS_FEEDS=
